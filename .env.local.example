# Isi dari Supabase Dashboard > Project Settings > API Keys / Connect
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Optional: force Demo Mode locally even after Supabase credentials are added.
# Production deployments ignore Demo Mode.
RE_SKIN_DEMO_MODE=false


# Nomor WhatsApp Bestie Care RE-SKIN (format Indonesia/internasional).
# Nama variabel ADMIN dipertahankan agar konfigurasi lama tetap kompatibel.
# Nomor publik Bestie Care: 628138809289 (tanpa tanda +).
NEXT_PUBLIC_RE_SKIN_ADMIN_WHATSAPP=628138809289
